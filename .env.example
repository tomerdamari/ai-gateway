# Copy to .env and fill in. Leave a provider key empty if you don't use that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin page (/admin) opens without a password from the office network.
# From outside it needs this password; leave empty to keep it closed to the outside entirely.
ADMIN_PASSWORD=

# Domain name pointing at this server -> automatic HTTPS. Leave empty for plain HTTP on the office network.
SITE_ADDRESS=

# 1 = chat opens without a login on the office network; people pick their own name (no passwords).
# Anyone inside can then act as anyone, so turn it off once real users are set up.
OPEN_ACCESS=
