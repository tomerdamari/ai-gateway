# Copy to .env and fill in. Leave a provider key empty if you don't use that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin page (/admin) opens without a password from the office network.
# From outside it needs this password; leave empty to keep it closed to the outside entirely.
ADMIN_PASSWORD=

# Domain name pointing at this server -> automatic HTTPS. Leave empty for plain HTTP on the office network.
SITE_ADDRESS=

# 1 = chat opens without a login on the office network; people pick their own name (no passwords).
# Anyone inside can then act as anyone, so turn it off once real users are set up.
OPEN_ACCESS=

# 1 = the gateway can't tell office from outside (cloud host, or another load balancer in front of Caddy):
# the admin page always needs ADMIN_PASSWORD and open access is off.
PUBLIC_DEPLOY=

# Extra host names the gateway answers to, comma separated (SITE_ADDRESS is already included).
ALLOWED_HOSTS=

# Mail server for the monthly summary email (admin > Reports). Leave SMTP_HOST empty to send nothing.
# SMTP_TLS: 1 = STARTTLS (port 587, default), ssl = encrypted from the start (port 465), 0 = none (internal mail server only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
