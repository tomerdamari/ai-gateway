# Copy to .env and fill in. Leave a provider key empty if you don't use that provider.
# Every setting, with its default, is listed in the documentation (/docs, "Server settings" and "Server security settings").
# On/off settings: 1, true, yes or on = on; anything else = off. Restart the gateway after a change.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Models on the company's own server (Ollama / vLLM): the address is set on the admin Models page.
# LOCAL_API_KEY only if that server needs a key. ALLOW_LOCAL_LOOPBACK=1 if it runs on this same machine (localhost).
LOCAL_API_KEY=
ALLOW_LOCAL_LOOPBACK=

# Admin page (/admin) opens without a password from the office network.
# From outside it needs this password; leave empty to keep it closed to the outside entirely.
# Use at least 16 characters: wrong attempts are logged as security events but don't lock it.
ADMIN_PASSWORD=

# Domain name pointing at this server -> automatic HTTPS. Leave empty for plain HTTP on the office network.
SITE_ADDRESS=

# 1 = chat opens without a login on the office network; people pick their own name (no passwords).
# Anyone inside can then act as anyone, so turn it off once real users are set up.
OPEN_ACCESS=

# 1 = the gateway can't tell office from outside (cloud host, or another load balancer in front of Caddy):
# the admin page always needs ADMIN_PASSWORD and open access is off.
PUBLIC_DEPLOY=

# Extra host names the gateway answers to, comma separated (SITE_ADDRESS is already included).
ALLOWED_HOSTS=

# Mail server for the monthly summary email (admin > Reports). Leave SMTP_HOST empty to send nothing.
# A sender is needed too: SMTP_FROM, or SMTP_USER when SMTP_FROM is empty.
# SMTP_TLS: 1 = STARTTLS (port 587, default), ssl = encrypted from the start (port 465), 0 = none (internal mail server only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Optional, defaults shown (see /docs for what each one does):
# EMBEDDINGS=            meaning search: openai | gemini | off (empty = the first provider with a key)
# PORT=8080
# GATEWAY_DB=gateway.db  (Docker sets /data/gateway.db)
# FIREGATE_DATA_KEY=     encryption key; empty = the <database>.key file next to the database. Back it up separately.
# TRUSTED_PROXIES=127.0.0.1,::1   (Docker sets the Caddy network too)
# MAX_BODY=41943040  MAX_REQUEST_BODY=1048576  MAX_OUTPUT_TOKENS=8192  MAX_CONCURRENT=4  MAX_MESSAGES=500
# SOURCE_ROOTS=          folders that folder knowledge sources may come from, comma separated
# ALLOW_PRIVATE_MCP=1    0 = also block MCP servers on internal-network addresses
